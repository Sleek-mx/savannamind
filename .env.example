# Site
# Local dev: http://localhost:3000
# Production (Vercel): https://savannamind-ashy.vercel.app
# Note: savannamind.vercel.app may point at a different Vercel project until reclaimed in the dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Savanna Mind project — ref epotmrwulmdpgqzuodwp)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Management API (for scripts/configure-supabase-auth.mjs only)
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Email (Resend — https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM=Savanna Mind <onboarding@resend.dev>
# With Resend test sender, use the Resend account owner's email until a domain is verified.
CONTACT_INBOX_EMAIL=your-resend-account@example.com

# Cloudflare Turnstile
# Production (Vercel): set both on the Production environment.
# TURNSTILE_SECRET_KEY is server-only. If it is missing, lesson and state APIs fail closed.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is public. Test keys (1x/2x/3x…) are rejected in production.
# Local dev can omit both; the widget uses Cloudflare's always-pass test site key.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Kibo tutor (B.AI)
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=DeepSeek-V4.1-Flash
